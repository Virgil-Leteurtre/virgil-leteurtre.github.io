---
// Page Studio AUXO : architecture intérieure et mobilier. Version validée par Virgil
// (reprise de 01_Prospection/Site web/studio-auxo.html). L'animation du logo est le composant IntroLogo, inchangé.
import { Font, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import IntroLogo from '../components/IntroLogo.astro';
import Logo from '../components/directions/Logo.astro';
import BullesAuxo from '../components/BullesAuxo.astro';
import membrane from '../assets/site/membrane.jpg';
import nal from '../assets/site/nal.jpg';
import obadia from '../assets/site/obadia.jpg';
import hegoburu from '../assets/site/hegoburu.jpg';
import dubon from '../assets/site/dubon.jpg';
import montgiron from '../assets/site/montgiron.jpg';
import ose from '../assets/site/ose.jpg';
import refuge from '../assets/site/refuge.jpg';
import fracture from '../assets/site/fracture.jpg';

// adresse de la page du projet, nom, description, page du portfolio PDF, cadrage, arche
const projets = [
  { slug: 'membrane', nom: 'Membrane', desc: "Rénovation d'une école de musique — projet de fin d'études", page: 3, image: membrane, cadrage: '50% 50%', arche: true },
  { slug: 'nal', nom: 'NAL', desc: "Rénovation d'un appartement locatif", page: 9, image: nal, cadrage: '50% 55%' },
  { slug: 'obadia', nom: 'Obadia', desc: 'Appartement adapté en location premium', page: 11, image: obadia, cadrage: '45% 60%' },
  { slug: 'hegoburu', nom: 'Hegoburu', desc: "Réhabilitation d'une échoppe familiale", page: 13, image: hegoburu, cadrage: '50% 55%' },
  { slug: 'dubon', nom: 'Dubon', desc: "Rénovation d'un appartement de 180 m²", page: 15, image: dubon, cadrage: '55% 40%', arche: true },
  { slug: 'mongiron', nom: 'Mongiron', desc: "Rénovation d'une bâtisse en pierre près de Saint-Émilion", page: 17, image: montgiron, cadrage: '40% 60%' },
  { slug: 'ose', nom: 'OSE', desc: 'Maison ressource pour enfants en difficulté', page: 20, image: ose, cadrage: '50% 60%' },
  { slug: 'le-refuge', nom: 'Le refuge', desc: 'Salle de pause pensée comme un refuge', page: 22, image: refuge, cadrage: '50% 50%', arche: true },
  { slug: 'fracture', nom: 'Fracture', desc: 'Canapé-salon convertible et modulable', page: 24, image: fracture, cadrage: '50% 50%' },
];
---

<Base
  title="Studio AUXO — architecture intérieure et mobilier · Virgil Leteurtre"
  description="Studio AUXO, l'agence d'architecture intérieure et de design de mobilier de Virgil Leteurtre."
>
  <Fragment slot="tete">
    <Font cssVariable="--police-manrope" />
    <Font cssVariable="--police-lecture" />
  </Fragment>

  <a class="retour" href="/" aria-label="Retour à l'accueil">← Accueil</a>

  <IntroLogo />

  <main class="suite" id="suite">
    <span id="projets"></span>
    <div class="suite__tete reveler">
      <h2>Architecture intérieure <em>&amp; mobilier</em></h2>
      <!-- Texte d'introduction du Studio AUXO : écrit avec les mots de Virgil, validé le 25/11/2026 -->
      <p class="suite__intro">
        Dans la mythologie grecque, Auxo est celle qui fait croître les plantes. C’est ainsi que je vois l’architecture : vivante, jamais figée,
        elle évolue avec le temps, son environnement et ceux qui l’habitent. Je m’inspire du vivant, et je me mets à votre place pour imaginer vos
        scènes de vie, comme au cinéma, afin de dessiner un intérieur qui vous ressemble et grandit avec vous.
      </p>
    </div>
    <div class="projets">
      {
        projets.map((p, i) => (
          <a class:list={['projet', 'reveler', { 'projet--arche': p.arche }]} href={`/projets/${p.slug}/`}>
            <span class="projet__cadre">
              <span class="projet__vitre">
                <Image src={p.image} alt={p.nom} widths={[480, 800, 1200, 1600]} sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 400px" style={`object-position: ${p.cadrage}`} />
              </span>
            </span>
            <span class="projet__legende">
              <span class="projet__num">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <span class="projet__titre">{p.nom}</span>
                <span class="projet__desc">{p.desc}</span>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </main>

  <footer class="pied">
    <Logo class="pied__logo" />
    <div class="pied__liens">
      <a href="mailto:virgilleteurtre@gmail.com">virgilleteurtre@gmail.com</a>
      <a href="tel:+33783296032">07 83 29 60 32</a>
      <a href="https://www.instagram.com/virgil_leteurtre/" target="_blank" rel="noopener">Instagram</a>
      <a href="/cinema/">Cinéma</a>
    </div>
  </footer>

  <BullesAuxo attendre />
</Base>

<script>
  import '../scripts/reveler';
</script>

<style is:global>
  :root {
    --manrope: var(--police-manrope, 'Manrope'), system-ui, sans-serif;
    --cadre: linear-gradient(145deg, #a0362c 0%, #4e0000 40%, #2a0000 100%);
    --doux: #6b2a22;
    --trait: rgba(78, 0, 0, 0.25);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --cadre: linear-gradient(145deg, #ffffff 0%, #fff6e7 40%, #c9b79c 100%);
      --doux: rgba(255, 246, 231, 0.78);
      --trait: rgba(255, 246, 231, 0.3);
    }
  }
  :root[data-theme='dark'] {
    --cadre: linear-gradient(145deg, #ffffff 0%, #fff6e7 40%, #c9b79c 100%);
    --doux: rgba(255, 246, 231, 0.78);
    --trait: rgba(255, 246, 231, 0.3);
  }

  /* Retour (même style que le bouton jour / nuit) */
  .retour {
    position: fixed;
    top: 20px;
    left: 20px;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid currentColor;
    color: var(--encre);
    font-family: var(--manrope);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
    background: var(--fond);
    opacity: 0.6;
    transition:
      opacity 0.3s ease,
      color 0.6s ease;
  }
  .retour:hover {
    opacity: 1;
  }

  /* Projets */
  .suite {
    width: min(1248px, 100% - 2 * clamp(20px, 6vw, 96px));
    margin: 0 auto;
    padding: clamp(80px, 12vw, 140px) 0 clamp(60px, 8vw, 96px);
  }
  .suite__tete {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: clamp(24px, 5vw, 64px);
    align-items: end;
    border-top: 1px solid var(--trait);
    padding-top: 40px;
    margin-bottom: clamp(48px, 7vw, 80px);
  }
  .suite h2 {
    font-weight: 400;
    font-size: clamp(40px, 6vw, 76px);
    line-height: 1;
    margin: 0;
  }
  .suite__intro {
    margin: 0;
    font-family: var(--manrope);
    font-size: 16px;
    line-height: 1.75;
    color: var(--doux);
  }
  .projets {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 32px;
    align-items: start;
  }
  .projet {
    display: flex;
    flex-direction: column;
    gap: 18px;
    color: inherit;
    text-decoration: none;
  }
  .projet:nth-child(3n + 2) {
    margin-top: 90px;
  }
  .projet:nth-child(3n + 3) {
    margin-top: 30px;
  }
  .projet__cadre {
    display: block;
    padding: 3px;
    border-radius: 11px;
    background: var(--cadre);
    box-shadow:
      inset 0 1px 0 rgba(255, 225, 215, 0.65),
      0 18px 36px rgba(40, 0, 0, 0.22),
      0 2px 4px rgba(40, 0, 0, 0.2);
    transition:
      transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .projet__vitre {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    isolation: isolate;
  }
  .projet__vitre img {
    display: block;
    width: 100%;
    height: 300px;
    object-fit: cover;
    background: #fff;
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .projet__vitre::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(118deg, rgba(255, 255, 255, 0.26) 0%, rgba(255, 255, 255, 0) 30%);
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.3);
    pointer-events: none;
  }
  .projet--arche .projet__cadre {
    border-radius: 223px 223px 11px 11px;
  }
  .projet--arche .projet__vitre {
    border-radius: 220px 220px 8px 8px;
  }
  .projet--arche .projet__vitre img {
    height: 480px;
  }
  .projet:hover .projet__cadre {
    transform: translateY(-6px);
    box-shadow:
      inset 0 1px 0 rgba(255, 225, 215, 0.65),
      0 30px 54px rgba(40, 0, 0, 0.28),
      0 2px 4px rgba(40, 0, 0, 0.2);
  }
  .projet:hover .projet__vitre img {
    transform: scale(1.04);
  }
  .projet__legende {
    display: flex;
    gap: 16px;
    align-items: baseline;
  }
  .projet__num {
    font-family: var(--manrope);
    font-size: 12px;
    letter-spacing: 0.2em;
  }
  .projet__titre {
    display: block;
    font-style: italic;
    font-size: 30px;
    line-height: 1.2;
  }
  .projet__desc {
    display: block;
    font-family: var(--manrope);
    font-size: 14px;
    line-height: 1.5;
    color: var(--doux);
  }

  /* apparition au défilement */
  .js .reveler {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 1s ease,
      transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .js .reveler.vu {
    opacity: 1;
    transform: none;
  }

  .pied {
    width: min(1248px, 100% - 2 * clamp(20px, 6vw, 96px));
    margin: 0 auto;
    padding: 48px 0 110px;
    border-top: 1px solid var(--trait);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    font-family: var(--manrope);
    font-size: 14px;
  }
  .pied a {
    color: inherit;
    text-decoration: none;
  }
  .pied a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .pied__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }
  .pied__logo {
    width: 120px;
    height: auto;
    color: var(--encre);
  }

  @media (max-width: 900px) {
    .projets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .projet:nth-child(n) {
      margin-top: 0;
    }
    .projet:nth-child(even) {
      margin-top: 60px;
    }
    .suite__tete {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .projets {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .projet:nth-child(n) {
      margin-top: 0;
    }
    .projet__vitre img,
    .projet--arche .projet__vitre img {
      height: 340px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .reveler {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
