---
// Une page par projet du Studio AUXO (/projets/membrane, /projets/nal…).
// Univers AUXO validé : crème / bordeaux, Bodoni Moda + Manrope, cadres bordeaux fins, arches.
// Contenu : src/data/projets.ts (repris du portfolio de Virgil).
import { Font, Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BullesAuxo from '../../components/BullesAuxo.astro';
import { projets, type ProjetComplet } from '../../data/projets';

export function getStaticPaths() {
  return projets.map((p, i) => ({
    params: { slug: p.slug },
    props: { projet: p, rang: i, precedent: projets[(i - 1 + projets.length) % projets.length], suivant: projets[(i + 1) % projets.length] },
  }));
}

interface Props {
  projet: ProjetComplet;
  rang: number;
  precedent: ProjetComplet;
  suivant: ProjetComplet;
}
const { projet, rang, precedent, suivant } = Astro.props;
const [couverture, ...autres] = projet.images;
const legende = (i: number) => projet.legendes[i] ?? projet.nom;
// les images après la couverture alternent : une grande, puis une paire, et ainsi de suite ; les textes s'intercalent
const blocs: { type: 'grande' | 'paire'; images: { src: ImageMetadata; alt: string }[] }[] = [];
for (let i = 0; i < autres.length; ) {
  if (blocs.length % 2 === 0 || i === autres.length - 1) {
    blocs.push({ type: 'grande', images: [{ src: autres[i], alt: legende(i + 1) }] });
    i += 1;
  } else {
    blocs.push({ type: 'paire', images: [{ src: autres[i], alt: legende(i + 1) }, { src: autres[i + 1], alt: legende(i + 2) }] });
    i += 2;
  }
}
const numero = String(rang + 1).padStart(2, '0');
---

<Base title={`${projet.nom} — ${projet.sujet} · Studio AUXO`} description={`${projet.nom} : ${projet.sujet}. ${projet.intro[0].slice(0, 120)}…`}>
  <Fragment slot="tete">
    <Font cssVariable="--police-manrope" />
    <Font cssVariable="--police-lecture" />
  </Fragment>

  <a class="retour" href="/studio-auxo/#projets" aria-label="Retour aux projets du Studio AUXO">← Studio AUXO</a>

  <main class="projet-page">
    <header class="p-tete">
      <div class="p-titre">
        <p class="p-rang">Projet {numero} sur {projets.length}</p>
        <h1>{projet.nom}</h1>
        <p class="p-sujet">{projet.sujet}</p>
      </div>
      <figure class:list={['p-couverture', { 'p-couverture--arche': projet.arche }]}>
        <span class="p-cadre">
          <span class="p-vitre">
            <Image src={couverture} alt={legende(0)} widths={[600, 1000, 1600, 2400]} sizes="(max-width: 900px) 100vw, 55vw" loading="eager" fetchpriority="high" />
          </span>
        </span>
      </figure>
    </header>

    <section class="p-fiche-bloc" aria-label="Fiche du projet">
      <dl class="p-fiche">
        {
          projet.fiche.map(([cle, valeur]) => (
            <div>
              <dt>{cle}</dt>
              <dd>{valeur}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="p-recit">
      <div class="p-intro reveler">
        {projet.intro.map((t, i) => <p class:list={{ 'p-chapeau': i === 0 }}>{t}</p>)}
      </div>
      <aside class="p-valeurs reveler" aria-label="Ce que le projet apporte">
        <h2>Ce que le projet apporte</h2>
        <ol>{projet.valeurs.map((v) => <li>{v}</li>)}</ol>
      </aside>
    </section>

    {
      blocs.map((bloc, i) => (
        <>
          <section class:list={['p-images', `p-images--${bloc.type}`]}>
            {bloc.images.map((img) => (
              <figure class="p-figure reveler">
                <span class="p-cadre">
                  <span class="p-vitre">
                    <Image src={img.src} alt={img.alt} widths={[600, 1000, 1600, 2400]} sizes={bloc.type === 'grande' ? '(max-width: 900px) 100vw, 80vw' : '(max-width: 900px) 100vw, 45vw'} />
                  </span>
                </span>
                <figcaption>{img.alt}</figcaption>
              </figure>
            ))}
          </section>
          {projet.sections[i] && (
            <section class="p-section reveler">
              <h2>{projet.sections[i].titre}</h2>
              <div>
                {projet.sections[i].textes.map((t) => (
                  <p>{t}</p>
                ))}
              </div>
            </section>
          )}
        </>
      ))
    }
    {
      projet.sections.slice(blocs.length).map((s) => (
        <section class="p-section reveler">
          <h2>{s.titre}</h2>
          <div>
            {s.textes.map((t) => (
              <p>{t}</p>
            ))}
          </div>
        </section>
      ))
    }

    <p class="p-portfolio reveler">
      Plans, coupes et détails : <a href={`/Portfolio_Virgil_Leteurtre.pdf#page=${projet.page}`} target="_blank" rel="noopener">voir le projet dans le portfolio (PDF)</a>
    </p>

    <nav class="p-suite" aria-label="Autres projets">
      {
        [
          { p: precedent, sens: 'Projet précédent' },
          { p: suivant, sens: 'Projet suivant' },
        ].map(({ p, sens }) => (
          <a class="p-voisin" href={`/projets/${p.slug}/`}>
            <span class="p-voisin-arche">
              <Image src={p.images[0]} alt="" widths={[400, 700]} sizes="(max-width: 700px) 40vw, 260px" />
            </span>
            <span class="p-voisin-texte">
              <small>{sens}</small>
              <strong>{p.nom}</strong>
              <span>{p.sujet}</span>
            </span>
          </a>
        ))
      }
    </nav>
  </main>

  <footer class="pied">
    <a href="/studio-auxo/#projets">Tous les projets du Studio AUXO</a>
    <div class="pied__liens">
      <a href="mailto:virgilleteurtre@gmail.com">virgilleteurtre@gmail.com</a>
      <a href="tel:+33783296032">07 83 29 60 32</a>
      <a href="/cinema/">Cinéma</a>
    </div>
  </footer>

  <BullesAuxo />
</Base>

<script>
  import '../../scripts/reveler';
</script>

<style is:global>
  :root {
    --lecture: var(--police-lecture, 'Newsreader'), Georgia, serif;
    --manrope: var(--police-manrope, 'Manrope'), system-ui, sans-serif;
    --cadre: linear-gradient(145deg, #a0362c 0%, #4e0000 40%, #2a0000 100%);
    --doux: #6b2a22;
    --trait: rgba(78, 0, 0, 0.25);
    --douceur: cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --cadre: linear-gradient(145deg, #ffffff 0%, #fff6e7 40%, #c9b79c 100%);
      --doux: rgba(255, 246, 231, 0.78);
      --trait: rgba(255, 246, 231, 0.3);
    }
  }
  :root[data-theme='dark'] {
    --cadre: linear-gradient(145deg, #ffffff 0%, #fff6e7 40%, #c9b79c 100%);
    --doux: rgba(255, 246, 231, 0.78);
    --trait: rgba(255, 246, 231, 0.3);
  }

  .retour {
    position: fixed;
    top: 20px;
    left: 20px;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid currentColor;
    color: var(--encre);
    font-family: var(--manrope);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
    background: var(--fond);
    opacity: 0.75;
    transition: opacity 0.3s ease;
  }
  .retour:hover {
    opacity: 1;
  }

  .projet-page {
    width: min(1248px, 100% - 2 * clamp(20px, 6vw, 96px));
    margin: 0 auto;
    padding-top: clamp(96px, 12vw, 150px);
  }

  /* --- Ouverture : le nom, et la couverture dans son cadre (arche ou fenêtre) --- */
  .p-tete {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
  }
  .p-rang {
    margin: 0 0 18px;
    font-family: var(--manrope);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--doux);
  }
  .p-titre h1 {
    margin: 0;
    font-weight: 400;
    font-style: italic;
    font-size: clamp(64px, 11vw, 168px);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }
  .p-sujet {
    margin: 22px 0 0;
    font-family: var(--lecture);
    max-width: 22ch;
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.2;
  }
  .p-couverture {
    margin: 0;
  }
  .p-cadre {
    display: block;
    padding: 3px;
    border-radius: 11px;
    background: var(--cadre);
    box-shadow:
      inset 0 1px 0 rgba(255, 225, 215, 0.65),
      0 24px 48px rgba(40, 0, 0, 0.22),
      0 2px 4px rgba(40, 0, 0, 0.2);
  }
  .p-vitre {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 8px;
  }
  .p-vitre img {
    display: block;
    width: 100%;
    height: auto;
  }
  .p-vitre::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(118deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0) 28%);
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.3);
    pointer-events: none;
  }
  .p-couverture .p-vitre img {
    height: min(72vh, 680px);
    object-fit: cover;
  }
  .p-couverture--arche .p-cadre {
    border-radius: 999px 999px 11px 11px;
  }
  .p-couverture--arche .p-vitre {
    border-radius: 999px 999px 8px 8px;
  }

  /* le seul mouvement orchestré : la couverture s'ouvre au chargement */
  @media (prefers-reduced-motion: no-preference) {
    .p-couverture .p-vitre {
      animation: p-ouvrir 1.6s var(--douceur) 0.2s both;
    }
    .p-couverture .p-vitre img {
      animation: p-recul 2.2s var(--douceur) 0.2s both;
    }
    .p-titre > * {
      animation: p-monter 1.1s var(--douceur) both;
    }
    .p-titre h1 {
      animation-delay: 0.15s;
    }
    .p-titre .p-sujet {
      animation-delay: 0.3s;
    }
  }
  @keyframes p-ouvrir {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes p-recul {
    from {
      transform: scale(1.18);
    }
    to {
      transform: none;
    }
  }
  @keyframes p-monter {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* --- Fiche --- */
  .p-fiche-bloc {
    margin-top: clamp(56px, 8vw, 96px);
    border-top: 1px solid var(--trait);
    border-bottom: 1px solid var(--trait);
  }
  .p-fiche {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }
  .p-fiche div {
    padding: 22px 24px 22px 0;
  }
  .p-fiche div:nth-child(n + 4) {
    border-top: 1px solid var(--trait);
  }
  .p-fiche dt {
    margin-bottom: 6px;
    font-family: var(--manrope);
    font-size: 12px;
    color: var(--doux);
  }
  .p-fiche dd {
    margin: 0;
    font-family: var(--lecture);
    font-size: 19px;
    line-height: 1.35;
  }

  /* --- Récit --- */
  .p-recit {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(32px, 6vw, 96px);
    margin: clamp(64px, 9vw, 120px) 0;
  }
  .p-intro p {
    max-width: 62ch;
    margin: 0 0 1.2em;
    font-family: var(--manrope);
    font-size: 16px;
    line-height: 1.8;
    color: var(--doux);
  }
  .p-intro .p-chapeau {
    max-width: 34ch;
    margin-bottom: 1.1em;
    font-family: var(--lecture);
    font-size: clamp(21px, 2vw, 26px);
    font-weight: 400;
    line-height: 1.5;
    color: var(--encre);
  }
  .p-valeurs {
    align-self: start;
    position: sticky;
    top: 90px;
    padding: 28px 0 0;
    border-top: 1px solid var(--encre);
  }
  .p-valeurs h2 {
    margin: 0 0 20px;
    font-weight: 400;
    font-style: italic;
    font-size: 26px;
  }
  .p-valeurs ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: valeur;
  }
  .p-valeurs li {
    counter-increment: valeur;
    display: grid;
    grid-template-columns: 34px 1fr;
    padding: 14px 0;
    border-bottom: 1px solid var(--trait);
    font-family: var(--manrope);
    font-size: 15px;
    line-height: 1.5;
  }
  .p-valeurs li::before {
    content: counter(valeur, decimal-leading-zero);
    font-family: var(--police);
    font-style: italic;
    font-size: 15px;
  }

  /* --- Images et textes intercalés --- */
  .p-images {
    display: grid;
    gap: clamp(20px, 3vw, 40px);
    margin: clamp(40px, 6vw, 80px) 0;
  }
  .p-images--grande .p-figure {
    width: min(100%, 1040px);
    margin-inline: auto;
  }
  .p-images--paire {
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }
  .p-images--paire .p-figure:nth-child(2) {
    margin-top: clamp(40px, 8vw, 120px);
  }
  .p-figure {
    margin: 0;
  }
  .p-figure figcaption {
    margin-top: 14px;
    font-family: var(--manrope);
    font-size: 13px;
    line-height: 1.5;
    color: var(--doux);
  }
  .p-section {
    display: grid;
    grid-template-columns: 4fr 7fr;
    gap: clamp(24px, 5vw, 80px);
    margin: clamp(64px, 9vw, 120px) 0;
    padding-top: 32px;
    border-top: 1px solid var(--trait);
  }
  .p-section h2 {
    margin: 0;
    font-weight: 400;
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.1;
  }
  .p-section p {
    max-width: 62ch;
    margin: 0 0 1.2em;
    font-family: var(--manrope);
    font-size: 16px;
    line-height: 1.8;
    color: var(--doux);
  }

  .p-portfolio {
    font-family: var(--lecture);
    margin: clamp(56px, 8vw, 96px) 0;
    font-size: clamp(22px, 2.2vw, 28px);
    text-align: center;
  }
  .p-portfolio a {
    font-style: italic;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }

  /* --- Projets voisins : deux arches --- */
  .p-suite {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 4vw, 56px);
    padding: clamp(40px, 6vw, 72px) 0;
    border-top: 1px solid var(--trait);
  }
  .p-voisin {
    display: flex;
    align-items: flex-end;
    gap: 24px;
    color: inherit;
    text-decoration: none;
  }
  .p-voisin + .p-voisin {
    flex-direction: row-reverse;
    text-align: right;
  }
  .p-voisin-arche {
    flex: 0 0 clamp(110px, 14vw, 180px);
  }
  .p-voisin-arche {
    display: block;
    width: clamp(110px, 14vw, 180px);
    padding: 3px;
    border-radius: 999px 999px 11px 11px;
    background: var(--cadre);
    overflow: hidden;
  }
  .p-voisin-arche img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 999px 999px 8px 8px;
    transition: transform 1s var(--douceur);
  }
  .p-voisin:hover .p-voisin-arche img {
    transform: scale(1.05);
  }
  .p-voisin-texte {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .p-voisin small {
    font-family: var(--manrope);
    font-size: 12px;
    color: var(--doux);
  }
  .p-voisin strong {
    font-weight: 400;
    font-style: italic;
    font-size: clamp(30px, 3.6vw, 52px);
    line-height: 1;
  }
  .p-voisin-texte > span {
    font-family: var(--manrope);
    font-size: 14px;
    color: var(--doux);
  }

  .pied {
    width: min(1248px, 100% - 2 * clamp(20px, 6vw, 96px));
    margin: 0 auto;
    padding: 40px 0 110px;
    border-top: 1px solid var(--trait);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 28px;
    font-family: var(--manrope);
    font-size: 14px;
  }
  .pied a {
    color: inherit;
    text-decoration: none;
  }
  .pied a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .pied__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }

  /* apparition au défilement (même réglage que la page Studio AUXO) */
  .js .reveler {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 1s ease,
      transform 1.1s var(--douceur);
  }
  .js .reveler.vu {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .js .reveler {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .p-tete,
    .p-recit,
    .p-section {
      grid-template-columns: 1fr;
    }
    .p-tete {
      align-items: start;
    }
    .p-couverture .p-vitre img {
      height: 62vh;
    }
    .p-fiche {
      grid-template-columns: 1fr 1fr;
    }
    .p-fiche div:nth-child(n + 3) {
      border-top: 1px solid var(--trait);
    }
    .p-valeurs {
      position: static;
    }
  }
  @media (max-width: 600px) {
    .p-images--paire,
    .p-suite {
      grid-template-columns: 1fr;
    }
    .p-images--paire .p-figure:nth-child(2) {
      margin-top: 0;
    }
    .p-voisin + .p-voisin {
      flex-direction: row;
      text-align: left;
    }
    .p-fiche {
      grid-template-columns: 1fr;
    }
    .p-fiche div:nth-child(n + 2) {
      border-top: 1px solid var(--trait);
    }
  }
</style>
