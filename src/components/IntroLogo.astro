---
// Animation d'ouverture du logo Studio AUXO (validée par Virgil le 24/11/2026).
// Les tracés viennent tels quels de l'export Illustrator (src/assets/logo/studio-auxo.svg) :
// 2 tracés pour le bloc S+A, puis les lettres t u d i o U X O.
import logoBrut from '../assets/logo/studio-auxo.svg?raw';

const viewBox = logoBrut.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 1334.11 683.46';
const traces = [...logoBrut.matchAll(/<path[^>]*\sd="([^"]+)"/g)].map((m) => m[1]);
if (traces.length !== 10) {
  throw new Error(`Logo AUXO : 10 tracés attendus, ${traces.length} trouvés`);
}
const mono = traces.slice(0, 2);
const lettres = traces.slice(2);
---

<header class="intro">
  <svg class="logo" viewBox={viewBox} role="img" aria-label="Studio AUXO" data-intro-logo>
    <defs>
      <!-- le nom est caché derrière la forme du S+A (zone noire du masque) et naît dans sa courbe -->
      <filter id="intro-adoucir" x="-5%" y="-5%" width="110%" height="110%">
        <feGaussianBlur stdDeviation="2.5"></feGaussianBlur>
      </filter>
      <mask id="intro-cache" maskUnits="userSpaceOnUse" x="-6000" y="-400" width="12000" height="1500">
        <rect x="-6000" y="-400" width="12000" height="1500" fill="#fff"></rect>
        <polygon data-intro-silhouette fill="#000" filter="url(#intro-adoucir)" points=""></polygon>
      </mask>
    </defs>
    <g data-intro-nom mask="url(#intro-cache)">
      {lettres.map((d) => <g class="lettre"><path d={d} /></g>)}
    </g>
    <g data-intro-mono>
      {mono.map((d) => <path d={d} />)}
    </g>
  </svg>

  <a class="defiler" href="#suite" data-intro-defiler>
    <span>Découvrir</span>
    <span class="trait"></span>
  </a>
</header>

<script>
  const logo = document.querySelector<SVGSVGElement>('[data-intro-logo]');
  if (logo) lancerIntro(logo);

  function lancerIntro(logo: SVGSVGElement) {
    const mono = logo.querySelector<SVGGElement>('[data-intro-mono]')!;
    const nom = logo.querySelector<SVGGElement>('[data-intro-nom]')!;
    const silhouette = logo.querySelector<SVGPolygonElement>('[data-intro-silhouette]')!;
    const defiler = document.querySelector<HTMLElement>('[data-intro-defiler]');

    /* Chronologie, en secondes
       0 → 0,9      le bloc S+A apparaît au centre (fondu, léger zoom, flou qui se dissipe)
       0,85 → 3,45  il glisse vers la gauche ; le nom sort de la forme du S, lettre par lettre
       ≈ 3,5        tout est en place, centré
       4,1          l'invitation « Découvrir » apparaît                                         */
    const T = { apparition: 0.9, glisseDebut: 0.85, glisse: 2.6, lettreDebut: 1.05, ecart: 0.11, lettre: 1.7, fin: 4.1 };

    const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 4);
    const clamp01 = (t: number) => Math.min(1, Math.max(0, t));
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    // lettres rangées de gauche à droite : les deux lignes sortent ensemble
    const lettres = [...nom.querySelectorAll<SVGGElement>('.lettre')]
      .map((l) => ({ l, x: l.getBBox().x }))
      .sort((a, b) => a.x - b.x)
      .map((o) => o.l);

    // mesures : le S+A démarre pile au centre, l'ensemble final est centré
    const bm = mono.getBBox();
    const bn = nom.getBBox();
    const gauche = bm.x;
    const droite = Math.max(bm.x + bm.width, bn.x + bn.width);
    const dx = (gauche + droite) / 2 - (bm.x + bm.width / 2);
    const cx = bm.x + bm.width / 2;
    const cy = bm.y + bm.height / 2;
    const haut = Math.min(bm.y, bn.y);
    const bas = Math.max(bm.y + bm.height, bn.y + bn.height);
    const marge = 20;
    logo.setAttribute('viewBox', `${gauche - marge} ${haut - marge} ${droite - gauche + 2 * marge} ${bas - haut + 2 * marge}`);

    tracerSilhouette();

    // Pour chaque hauteur, le point le plus à droite du S+A. Tout ce qui est à gauche de ce bord
    // cache le nom (creux du S compris) : les lettres naissent dans la forme elle-même.
    function tracerSilhouette() {
      const formes = [...mono.querySelectorAll<SVGPathElement>('path')];
      const pt = new DOMPoint();
      const pas = 3;
      const y0 = bm.y;
      const y1 = bm.y + bm.height;
      const ys: number[] = [];
      const brut: number[] = [];
      for (let y = y0; y <= y1; y += pas) {
        let bord = NaN;
        for (let x = bm.x + bm.width; x >= bm.x; x -= 2) {
          pt.x = x;
          pt.y = y;
          if (formes.some((f) => f.isPointInFill(pt))) {
            bord = x;
            break;
          }
        }
        ys.push(y);
        brut.push(bord);
      }
      for (let i = 0; i < brut.length; i++) if (Number.isNaN(brut[i])) brut[i] = i > 0 ? brut[i - 1] : bm.x;
      const lisse = brut.map((v, i) => Math.max(v, brut[i - 1] ?? v, brut[i + 1] ?? v) + 3);
      const pts: number[][] = [[-6000, y0 - 400], [lisse[0], y0 - 400]];
      ys.forEach((y, i) => pts.push([lisse[i], y]));
      pts.push([lisse[lisse.length - 1], y1 + 400], [-6000, y1 + 400]);
      silhouette.setAttribute('points', pts.map((p) => p.map((v) => v.toFixed(1)).join(',')).join(' '));
    }

    function dessiner(s: number) {
      // 1. apparition du bloc S+A
      const a = easeOut(clamp01(s / T.apparition));
      const echelle = lerp(1.06, 1, a);
      // 2. glissement vers la gauche
      const g = easeInOut(clamp01((s - T.glisseDebut) / T.glisse));
      const x = lerp(dx, 0, g);
      mono.setAttribute('transform', `translate(${x} 0) translate(${cx} ${cy}) scale(${echelle}) translate(${-cx} ${-cy})`);
      mono.style.opacity = String(a);
      mono.style.filter = a < 1 ? `blur(${(1 - a) * 4}px)` : '';
      // la silhouette qui cache le nom suit le bloc
      silhouette.setAttribute('transform', `translate(${x} 0)`);
      // 3. les lettres, une à une
      lettres.forEach((l, i) => {
        const p = easeOut(clamp01((s - T.lettreDebut - i * T.ecart) / T.lettre));
        l.setAttribute('transform', `translate(${lerp(-90, 0, p)} 0)`);
        l.style.opacity = String(p);
      });
    }

    let depart: number | null = null;
    function boucle(maintenant: number) {
      if (depart === null) depart = maintenant;
      const s = (maintenant - depart) / 1000;
      dessiner(s);
      if (s >= T.fin) {
        defiler?.classList.add('visible');
        return;
      }
      requestAnimationFrame(boucle);
    }

    dessiner(0);
    logo.classList.add('pret');

    // en développement seulement : « ?t=1.6 » fige l'animation à 1,6 s pour l'analyser
    const fige = import.meta.env.DEV ? new URLSearchParams(location.search).get('t') : null;
    if (fige !== null) {
      dessiner(Number(fige));
      defiler?.classList.toggle('visible', Number(fige) >= T.fin);
    } else if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      dessiner(99);
      defiler?.classList.add('visible');
    } else {
      setTimeout(() => requestAnimationFrame(boucle), 250);
    }
  }
</script>

<style>
  .intro {
    position: relative;
    height: 100vh;
    height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .logo {
    width: min(72vw, 760px);
    height: auto;
    overflow: visible;
    fill: var(--encre);
    transition: fill 0.6s ease;
  }
  @media (max-width: 600px) {
    .logo {
      width: 86vw;
    }
  }
  /* avant le lancement : rien ne clignote */
  :global(.js) .logo {
    visibility: hidden;
  }
  :global(.js) .logo.pret {
    visibility: visible;
  }

  .defiler {
    position: absolute;
    left: 50%;
    bottom: 5vh;
    transform: translate(-50%, 8px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: var(--encre);
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 1s ease, transform 1s ease;
  }
  .defiler.visible {
    opacity: 0.75;
    transform: translate(-50%, 0);
  }
  .trait {
    width: 1px;
    height: 42px;
    background: currentColor;
    transform-origin: top;
    animation: auxo-trait 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes auxo-trait {
    0% { transform: scaleY(0); opacity: 1; }
    50% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .trait {
      animation: none;
    }
  }
</style>
