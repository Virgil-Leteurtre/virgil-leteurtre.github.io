---
// Bulles « Portfolio · CV · Contact » toujours visibles en bas de l'écran, dans la DA du Studio AUXO
// (crème / bordeaux, cadre bordeaux fin, Bodoni italique). Demande de Virgil, 25/11/2026.
// Sur la page Studio AUXO, elles attendent la fin de l'animation du logo (attendre = true).
interface Props {
  attendre?: boolean;
}
const { attendre = false } = Astro.props;
---

<nav class:list={['bulles', { 'bulles--attente': attendre }]} aria-label="Portfolio, CV et contact" data-bulles>
  <button type="button" data-ouvre-auxo="portfolio">Portfolio</button>
  <button type="button" data-ouvre-auxo="cv">CV</button>
  <button type="button" data-ouvre-auxo="contact">Contact</button>
</nav>

<dialog class="fenetre-auxo" id="auxo-portfolio" aria-labelledby="auxo-t-portfolio">
  <div class="fa-cadre">
    <div class="fa-contenu" data-lenis-prevent>
      <button class="fa-fermer" type="button" aria-label="Fermer">×</button>
      <h2 id="auxo-t-portfolio">Portfolio</h2>
      <p>Sélection de travaux 2021—2026 : architecture intérieure, design de mobilier et décor de cinéma.</p>
      <div class="fa-liens">
        <a href="/Portfolio_Virgil_Leteurtre.pdf" target="_blank" rel="noopener">Ouvrir le portfolio (PDF)</a>
      </div>
    </div>
  </div>
</dialog>

<dialog class="fenetre-auxo" id="auxo-cv" aria-labelledby="auxo-t-cv">
  <div class="fa-cadre">
    <div class="fa-contenu" data-lenis-prevent>
      <button class="fa-fermer" type="button" aria-label="Fermer">×</button>
      <h2 id="auxo-t-cv">CV</h2>
      <p>Diplômé en architecture intérieure et design à LISAA Bordeaux (titre RNCP niveau 7), deux ans d'alternance à L'Atelier D à Mérignac, stage déco sur Le Règne animal.</p>
      <div class="fa-liens">
        <a href="/CV_Virgil_Leteurtre.pdf" target="_blank" rel="noopener">Télécharger le CV (PDF)</a>
      </div>
    </div>
  </div>
</dialog>

<dialog class="fenetre-auxo" id="auxo-contact" aria-labelledby="auxo-t-contact">
  <div class="fa-cadre">
    <div class="fa-contenu" data-lenis-prevent>
      <button class="fa-fermer" type="button" aria-label="Fermer">×</button>
      <h2 id="auxo-t-contact">Contact</h2>
      <div class="fa-liens">
        <a href="tel:+33783296032">07 83 29 60 32</a>
        <a href="mailto:virgilleteurtre@gmail.com">virgilleteurtre@gmail.com</a>
        <a href="https://www.instagram.com/virgil_leteurtre/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.linkedin.com/in/virgil-leteurtre-b4b375235/" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </div>
</dialog>

<script>
  const bulles = document.querySelector<HTMLElement>('[data-bulles]');
  // page Studio AUXO : les bulles arrivent après l'animation du logo (4,1 s), ou dès qu'on fait défiler
  if (bulles?.classList.contains('bulles--attente')) {
    const montrer = () => bulles.classList.remove('bulles--attente');
    const calme = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    setTimeout(montrer, calme ? 0 : 4300);
    window.addEventListener('scroll', montrer, { once: true, passive: true });
  }
  document.querySelectorAll<HTMLElement>('[data-ouvre-auxo]').forEach((b) =>
    b.addEventListener('click', () => (document.getElementById('auxo-' + b.dataset.ouvreAuxo) as HTMLDialogElement | null)?.showModal()),
  );
  document.querySelectorAll<HTMLDialogElement>('dialog.fenetre-auxo').forEach((d) => {
    d.querySelector('.fa-fermer')?.addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => {
      if (e.target === d) d.close();
    });
  });
</script>

<style is:global>
  .bulles {
    position: fixed;
    left: 50%;
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 45;
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: var(--cadre, linear-gradient(145deg, #a0362c 0%, #4e0000 40%, #2a0000 100%));
    box-shadow:
      inset 0 1px 0 rgba(255, 225, 215, 0.6),
      0 16px 34px rgba(40, 0, 0, 0.22);
    transform: translateX(-50%);
    transition:
      opacity 0.8s ease,
      transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .bulles--attente {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 24px);
  }
  .bulles button {
    min-height: 44px;
    padding: 0 22px;
    border: 0;
    border-radius: 999px;
    background: var(--fond);
    color: var(--encre);
    font-family: var(--police);
    font-style: italic;
    font-size: 18px;
    cursor: pointer;
    transition:
      background-color 0.4s ease,
      color 0.4s ease;
  }
  .bulles button:hover,
  .bulles button:focus-visible {
    background: var(--encre);
    color: var(--fond);
  }
  @media (max-width: 420px) {
    .bulles button {
      padding: 0 16px;
      font-size: 17px;
    }
  }

  .fenetre-auxo {
    width: min(560px, 100% - 32px);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--encre);
    overflow: visible;
  }
  .fenetre-auxo::backdrop {
    background: color-mix(in srgb, var(--fond) 55%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .fenetre-auxo[open] {
    animation: fa-ouvrir 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes fa-ouvrir {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .fa-cadre {
    padding: 3px;
    border-radius: 22px;
    background: var(--cadre, linear-gradient(145deg, #a0362c 0%, #4e0000 40%, #2a0000 100%));
    box-shadow:
      inset 0 1px 0 rgba(255, 225, 215, 0.6),
      0 40px 90px rgba(40, 0, 0, 0.3);
  }
  .fa-contenu {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(26px, 5vw, 44px);
    border-radius: 19px;
    background: var(--fond);
  }
  .fa-contenu h2 {
    margin: 0;
    font-weight: 400;
    font-style: italic;
    font-size: clamp(40px, 7vw, 60px);
    line-height: 1;
  }
  .fa-contenu p {
    margin: 0;
    font-family: var(--police-manrope, 'Manrope'), system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: var(--doux, #6b2a22);
  }
  .fa-liens {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--trait, rgba(78, 0, 0, 0.25));
  }
  .fa-liens a {
    padding: 14px 0;
    border-bottom: 1px solid var(--trait, rgba(78, 0, 0, 0.25));
    color: inherit;
    font-size: 22px;
    text-decoration: none;
    transition: padding-left 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .fa-liens a:hover {
    padding-left: 10px;
    font-style: italic;
  }
  .fa-fermer {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    font-size: 20px;
    cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) {
    .bulles,
    .fenetre-auxo[open] {
      transition: none;
      animation: none;
    }
  }
</style>
